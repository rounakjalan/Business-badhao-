# Copy this file to .env before running login.mjs or worker.mjs, or use
# --env-file (see README.md). Never commit a real .env — it holds the same
# bearer secret Business Badhao's deployment uses to authenticate this
# runtime, and is loaded automatically by the Docker/systemd setups in
# README.md.

# ============================================================================
# REQUIRED
# ============================================================================

# Your Business Badhao deployment's own base URL (no trailing slash).
BUSINESS_BADHAO_API_URL=https://your-deployment.vercel.app

# MUST be the exact same value as this Vercel deployment's own
# INSTAGRAM_DISCOVERY_RUNTIME_TOKEN environment variable — this is the
# server-to-server bearer secret authenticating every call this runtime makes
# (session-report, jobs/claim, jobs/complete, jobs/status). Generate one long
# random secret (e.g. `openssl rand -hex 32`) and set it in both places.
INSTAGRAM_DISCOVERY_RUNTIME_TOKEN=

# Absolute path to a REAL, locally installed Chrome or Chromium binary on
# THIS machine — e.g. /usr/bin/google-chrome, /usr/bin/chromium,
# /Applications/Google Chrome.app/Contents/MacOS/Google Chrome. puppeteer-core
# does not bundle or download a browser; you must already have one installed.
# The Docker image sets this to /usr/bin/chromium automatically.
CHROMIUM_EXECUTABLE_PATH=

# ============================================================================
# OPTIONAL — sane defaults if left unset
# ============================================================================

# Space-separated extra Chromium launch flags. Leave unset on bare-metal —
# the real OS sandbox should stay on. The Docker image sets this to
# "--no-sandbox --disable-dev-shm-usage" automatically, which headless
# Chromium typically needs under Docker's default seccomp/tmpfs limits.
CHROMIUM_EXTRA_ARGS=

# Where this runtime keeps each organization's dedicated, isolated Chromium
# profile directory (one subdirectory per organizationId — never shared
# between organizations). Treat this directory like a secrets store: it
# contains real, live Instagram session state. Back it up and restrict its
# permissions accordingly. Default: ./profiles
PROFILES_DIR=./profiles

# How often (ms) each worker loop polls Business Badhao for a new discovery
# job when idle. Default: 4000
WORKER_POLL_INTERVAL_MS=4000

# How many independent claim-and-process loops run concurrently in this one
# process — each loop can process a different organization's job at the same
# time (the server-side atomic claim guarantees no two loops, in this
# process or another, ever process the same job). Keep this modest: each
# loop that's actively working owns one real, resource-heavy Chromium
# process. Default: 1
WORKER_CONCURRENCY=1

# Hard ceiling (ms) on how long a single job (one search, or one session
# check) may run before the worker force-closes its browser and reports it
# failed. Protects against a hung page/navigation blocking that loop
# forever. Default: 180000 (3 minutes)
WORKER_JOB_TIMEOUT_MS=180000

# Exponential-backoff ceiling (ms) applied after repeated failures reaching
# Business Badhao (network issues, deployment down, etc.) — backs off
# 2x per consecutive failure, capped here, and resets on the next success.
# Default: 60000
WORKER_MAX_BACKOFF_MS=60000

# How many consecutive polling failures before an escalated warning is
# logged (the backoff itself still applies from the very first failure).
# Purely a logging threshold. Default: 5
WORKER_MAX_CONSECUTIVE_FAILURES=5

# How long (ms) SIGTERM/SIGINT waits for an in-flight job to finish before
# shutting down anyway. Keep at or below your process manager's own stop
# timeout (e.g. systemd's TimeoutStopSec). Default: 15000
WORKER_SHUTDOWN_GRACE_MS=15000

# Local port for this runtime's own GET /health endpoint (worker status,
# queue depth, last job outcome — never a credential; see README.md).
# 0/unset disables it. Default: unset (disabled)
HEALTH_CHECK_PORT=8787

# Conservative anti-abuse bounds for one discovery job — see README.md's own
# "Safety bounds" section for why these exist and stay conservative.
# Defaults: 15 profiles per job, enrich (visit) the first 8 of them
# individually, 400ms politeness delay between profile visits.
INSTAGRAM_MAX_PROFILES_PER_JOB=15
INSTAGRAM_PROFILE_ENRICH_LIMIT=8
INSTAGRAM_POLITENESS_DELAY_MS=400
