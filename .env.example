# Supabase project configuration.
# Find these under your Supabase project's Settings > API page
# (or run `supabase status` for your local dev stack).
#
# Both variables below are PUBLIC and safe to ship to the browser — that is
# by design. Supabase's security model relies on Row Level Security (RLS)
# policies in the database, not on keeping the anon key secret.
#
# Never put the service-role/secret key in a NEXT_PUBLIC_ variable, or in
# any file that is bundled for the browser. This app does not use the
# service-role key at all: every request runs as the signed-in user, and
# tenant isolation is enforced entirely by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Absolute origin of this deployment (no trailing slash), e.g.
# https://business-badhao.vercel.app. Used to build the email-confirmation
# redirect link (see src/lib/site-url.ts) so it doesn't fall back to
# Supabase's dashboard-configured Site URL, which defaults to localhost.
# Falls back to Vercel's own deployment URL, then localhost, if unset.
NEXT_PUBLIC_SITE_URL=

# =============================================================================
# AI provider configuration (src/lib/ai) — powers the "Ask AI" sidekick today
# and every future agent (campaign planner, lead discovery, etc.) later.
#
# Business Badhao is provider-agnostic by design: agents call a single
# Hermes service, which calls whichever provider is configured below. None
# of these keys are ever prefixed with NEXT_PUBLIC_ — they are read only in
# server-side code (Server Actions), never bundled for the browser.
# =============================================================================

# Which provider is primary. One of: openrouter | huggingface | groq
# Defaults to openrouter if unset.
AI_PROVIDER=openrouter

# Optional second provider to try if the primary fails. Leave EMPTY for no
# fallback (the default) — fallback is opt-in on purpose, so a provider
# outage can never silently start billing a different provider you didn't
# choose. Must differ from AI_PROVIDER if set.
AI_FALLBACK_PROVIDER=

# Optional tuning; sensible defaults are used if these are unset.
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1

# --- OpenRouter — the primary provider for research/reasoning tasks --------
# (campaign planning, prospect research, qualification, outreach, loss
# analysis, etc. — see src/lib/ai/router/model-router.ts). Get a key at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
# Defaults to nvidia/nemotron-3-ultra-550b-a55b:free if unset — our
# configured primary model (free endpoint). Fully overridable: set this to
# any other OpenRouter model slug (see https://openrouter.ai/models) without
# touching any code. Free-tier slugs can change on OpenRouter's side, so if
# this stops working, confirm the current exact slug there before assuming
# it's a code bug.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Hugging Face (optional) -------------------------------------------------
# Uses HF's OpenAI-compatible "Inference Providers" router. Not free/unlimited
# — billing depends on your HF account and the model's hosting provider. Both
# variables must be set together for this provider to be usable; if either is
# missing, it's treated as not configured (never used as a silent default).
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=

# --- Groq (optional) — the preferred fast/classification provider ----------
# (intent detection today — see src/lib/ai/router/model-router.ts). Both
# variables must be set together for this provider to be usable. No default
# model is set here on purpose — Groq's hosted lineup changes, so pick one
# currently available on your account rather than relying on a hard-coded
# value that could go stale. Until both are set, tasks that prefer Groq
# automatically and transparently use AI_PROVIDER instead — nothing breaks.
GROQ_API_KEY=
GROQ_MODEL=

# --- Tavily (optional) — real web search for Lead Discovery -----------------
# Lead Discovery (src/lib/ai/agents/discovery.ts) needs a real search API to
# find real prospects — an AI model alone cannot browse the web, and this
# app does not ship with any search/scraping provider's credentials. Get a
# key at https://tavily.com (has a free tier). Until this is set, Lead
# Discovery honestly reports "not configured" — see NullDiscoveryProvider —
# it never fabricates prospects instead. Tavily is the PRIMARY provider.
TAVILY_API_KEY=

# --- Exa (optional) — fallback search provider for Lead Discovery ----------
# Used ONLY when a Tavily search call actually fails (quota exhaustion, rate
# limit, provider outage, network/timeout) — never merely because a search
# legitimately found zero results. Not required for Tavily discovery to
# work: with TAVILY_API_KEY set and this unset, Lead Discovery runs exactly
# as before. Get a key at https://exa.ai (has a free tier).
EXA_API_KEY=
