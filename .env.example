# Supabase project configuration.
# Find these under your Supabase project's Settings > API page
# (or run `supabase status` for your local dev stack).
#
# Both variables below are PUBLIC and safe to ship to the browser — that is
# by design. Supabase's security model relies on Row Level Security (RLS)
# policies in the database, not on keeping the anon key secret.
#
# Never put the service-role/secret key in a NEXT_PUBLIC_ variable, or in
# any file that is bundled for the browser. This app does not use the
# service-role key at all: every request runs as the signed-in user, and
# tenant isolation is enforced entirely by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# OpenRouter API key, used server-side only to power the "Ask AI" sidekick
# (Hermes 4 70B). Get one at https://openrouter.ai/keys.
#
# Deliberately NOT prefixed with NEXT_PUBLIC_ — this key must never reach
# the browser. It's only read from src/lib/ai/openrouter.ts, which only
# ever runs on the server (a Server Action). If this is unset, Ask AI shows
# a friendly "not connected yet" message instead of failing.
OPENROUTER_API_KEY=your-openrouter-api-key
